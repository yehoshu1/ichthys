{
  "name": "ichthys-discord-bot",
  "version": "0.1.0-beta.1",
  "description": "A scalable Discord bot built with TypeScript",
  "packageManager": "npm@11.9.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "cli": "tsx scripts/cli.ts",
    "build": "tsc -p tsconfig.bot.json && node scripts/link-dist-shared-runtime.js",
    "dev": "tsx watch src/bot/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dashboard:dev\"",
    "dashboard:dev": "next dev src/dashboard -p ${PORT:-4002}",
    "dashboard:build": "next build src/dashboard",
    "dashboard:start": "next start src/dashboard -p ${PORT:-4002}",
    "start": "node dist/bot/index.js",
    "deploy": "tsx src/utils/deployCommands.ts",
    "deploy:prod": "node scripts/deployCommands.js",
    "deploy:check": "tsx scripts/check-commands.ts",
    "guard:commands": "tsx scripts/check-command-catalog.ts",
    "guard:modules": "tsx scripts/check-module-guards.ts",
    "guard:module-ownership": "tsx scripts/check-module-ownership.ts",
    "module:remove:dry-run": "tsx scripts/module-remove-dry-run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-migrations.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:backup:list": "tsx scripts/backup-db.ts list",
    "db:restore": "tsx scripts/restore-db.ts",
    "db:restore:list": "tsx scripts/restore-db.ts list",
    "deploy:safe": "bash scripts/deploy-with-backup.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.bot.json",
    "lint": "eslint .",
    "validate": "npm run guard:commands && npm run guard:modules && npm run guard:module-ownership && npm run typecheck && npm run test"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "Ixoye Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/yehoshu1/ichthys.git"
  },
  "bugs": {
    "url": "https://github.com/yehoshu1/ichthys/issues"
  },
  "license": "GPL-3.0",
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/mdx": "^2.0.13",
    "@types/react-color": "^3.0.13",
    "canvas": "^3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "date-fns": "^4.1.0",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^12.42.0",
    "fumadocs-core": "^16.9.0",
    "fumadocs-mdx": "^15.0.7",
    "fumadocs-ui": "^16.9.0",
    "lru-cache": "^11.2.6",
    "lucide-react": "^0.563.0",
    "luxon": "^3.7.2",
    "next": "^16.2.0",
    "next-auth": "^4.24.13",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "react": "^19.2.4",
    "react-color": "^2.19.3",
    "react-day-picker": "^9.13.1",
    "react-dom": "^19.2.4",
    "react-is": "^19.0.0",
    "recharts": "^3.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.15.14",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.24.0",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^1.6.0"
  },
  "overrides": {
    "fumadocs-mdx": {
      "vite": "^5.4.21"
    },
    "@emoji-mart/react": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  }
}
