{
  "name": "ixoye-discord-bot",
  "version": "1.0.0",
  "description": "A scalable Discord bot built with TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/bot/index.ts",
    "dashboard:dev": "next dev src/dashboard",
    "dashboard:build": "next build src/dashboard",
    "dashboard:start": "next start src/dashboard",
    "start": "node dist/bot/index.js",
    "deploy": "tsx src/utils/deployCommands.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "discord",
    "bot",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
