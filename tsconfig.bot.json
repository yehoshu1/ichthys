{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": false,
        "baseUrl": ".",
        "paths": {
            "@shared/*": ["./src/shared/*"]
        }
    },
    "include": [
        "src/bot/**/*",
        "src/shared/**/*"
    ],
    "exclude": [
        "src/dashboard/**/*",
        "node_modules"
    ]
}