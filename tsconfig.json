{
    "compilerOptions": {
        "target": "ES2022",
        "module": "esnext",
        "lib": [
            "dom",
            "dom.iterable",
            "ES2022"
        ],
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "incremental": true,
        "plugins": [
            {
                "name": "next"
            }
        ],
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "./src/*"
            ],
            "@/lib/*": [
                "./src/dashboard/lib/*"
            ],
            "@/components/*": [
                "./src/dashboard/components/*"
            ],
            "@shared/*": [
                "./src/shared/*"
            ]
        },
        "allowJs": true,
        "noEmit": true
    },
    "include": [
        "next-env.d.ts",
        "src/**/*",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}