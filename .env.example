# Ichthys environment template.
# Copy to .env and fill in real values. Never commit .env.

# Discord Bot Token (from https://discord.com/developers/applications)
# Server Configuration
PORT=4002
API_BASE_URL=http://api:4002
NEXT_PUBLIC_API_BASE=http://localhost:4002

# Discord Bot Configuration
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_SECRET=your_client_secret_here

# Public Discord Client ID (dashboard invite button)
# Needed by the dashboard's "Invite Bot to Server" flow
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_client_id_here

# Dashboard URL (for /dashboard command)
# Set this to your dashboard's base URL. Users will access their server at {DASHBOARD_URL}/dashboard/{guildId}
# If not set, each guild must configure their own URL via /dashboard set
DASHBOARD_URL=http://localhost:4002

# Domain for reverse proxy routing (uncomment if using Traefik or custom proxy)
# DOMAIN=yourdomain.com

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ichthys
POSTGRES_USER=ichthys
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://ichthys:change_me@localhost:5432/ichthys

# PostgreSQL TLS (optional)
# PG_SSL=true enables TLS; set PG_SSL_REJECT_UNAUTHORIZED=false only for
# self-signed certificates in trusted networks
PG_SSL=false
# PG_SSL_REJECT_UNAUTHORIZED=true

# ==========================================
# PERFORMANCE TUNING (New)
# ==========================================

# PostgreSQL Connection Pool Settings
# Adjust based on your server's capacity and load
PG_POOL_MAX=8                     # Maximum connections in pool (default: 8)
PG_IDLE_TIMEOUT_MS=30000          # Close idle connections after 30s (default: 30000)
PG_CONNECT_TIMEOUT_MS=10000       # Connection timeout 10s (default: 10000)
PG_QUERY_TIMEOUT_MS=30000         # Query timeout 30s (default: 30000)
PG_STATEMENT_TIMEOUT_MS=30000     # Statement timeout 30s (default: 30000)

# Discord.js Cache and Sweeper Settings
DISCORD_MESSAGE_CACHE_LIMIT=150       # Max cached messages per channel manager
DISCORD_REACTION_CACHE_LIMIT=100      # Max cached reactions
DISCORD_REACTION_USER_CACHE_LIMIT=100 # Max cached users per reaction
DISCORD_MESSAGE_SWEEP_INTERVAL_SEC=300 # Sweep messages every 5 minutes
DISCORD_MESSAGE_SWEEP_LIFETIME_SEC=600 # Remove messages older than 10 minutes

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000        # Rate limit window in ms (default: 60000 = 1 min)
RATE_LIMIT_MAX_REQUESTS=100       # Max requests per window (default: 100)

# Redis (optional) - shared rate-limit backend for multi-instance deployments.
# When unset, rate limiting falls back to per-instance in-memory storage.
# REDIS_URL=redis://redis:6379

# Cache Configuration
CACHE_TTL_MS=60000               # Default cache TTL in ms (default: 60000)
CACHE_MAX_ENTRIES=1000           # Maximum cache entries (default: 1000)
MAX_SPAM_TRACKER_ENTRIES=10000   # Max in-memory spam tracking entries
MAX_PATTERN_CACHE_SIZE=2000      # Max compiled moderation regex patterns
MAX_ALIAS_COOLDOWN_ENTRIES=5000  # Max alias cooldown entries
MAX_ACTIVITY_BUFFER_ENTRIES=2000 # Max buffered analytics entries
MAX_REACTION_ROLE_CACHE_ENTRIES=500 # Max reaction-role cache entries
MAX_COMMAND_CONFIG_GUILD_CACHE_ENTRIES=500 # Max command config cache entries

# Voice XP Processing
VOICE_XP_CHUNK_SIZE=100          # Profiles processed per chunk (default: 100)
VOICE_XP_CHUNK_DELAY_MS=10       # Delay between chunks in ms (default: 10)

# User Cache Cleanup
USER_CACHE_MAX_AGE_DAYS=30       # Days to keep user cache (default: 30)
USER_CACHE_BATCH_SIZE=1000       # Cleanup batch size (default: 1000)

# ==========================================
# Security Secrets
# ==========================================

# Webhook Secret Encryption Key (required for webhook features)
# Minimum 16 characters, used to encrypt webhook secrets at rest with AES-256-GCM
WEBHOOK_SECRET_ENCRYPTION_KEY=change_me_random_16plus_chars

# Anonymous Poll Secret (required for anonymous poll features)
# Minimum 16 characters, used to anonymize user IDs in anonymous polls
ANONYMIZE_SECRET=change_me_different_random_16plus_chars

# Metrics Endpoint Token (recommended for production)
# Used to protect /api/metrics and /api/health endpoints
METRICS_TOKEN=change_me_random_metrics_token

# ==========================================
# Dashboard Security (CSRF & Proxies)
# ==========================================

# Comma-separated allowlist of origins permitted for state-changing requests
# (CSRF same-origin checks). Set this in production; when set, client-supplied
# X-Forwarded-* headers are ignored for origin validation.
TRUSTED_ORIGINS=https://yourdomain.com

# Number of trusted reverse proxies in front of the dashboard (used to derive
# the real client IP from X-Forwarded-For for rate limiting).
# 0/unset = app treated as directly exposed (XFF ignored). Behind Traefik or
# nginx, set to 1.
TRUST_PROXY_DEPTH=1

# ==========================================
# Backup Controls
# ==========================================
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_COUNT=10

# NextAuth Configuration (Dashboard)
NEXTAUTH_URL=http://localhost:4002
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32

# OAuth Configuration
OAUTH_REDIRECT_URI=http://localhost:4002/oauth/callback

# Logging & Development
LOG_LEVEL=info
NODE_ENV=development

# Skip Next.js type checking during dashboard builds (CI/fast builds only)
# SKIP_NEXT_TYPECHECK=0

# PM2 Process Restart Safety (production)
BOT_MAX_MEMORY_RESTART=700M
DASHBOARD_MAX_MEMORY_RESTART=900M

# Discord Guild/Server ID (for testing slash commands in a specific server)
GUILD_ID=your_guild_id_here
