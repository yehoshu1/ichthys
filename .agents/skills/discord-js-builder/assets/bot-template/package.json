{
  "name": "discord-bot",
  "version": "1.0.0",
  "description": "A Discord bot built with discord.js and TypeScript using Bun",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "deploy": "bun src/deploy-commands.ts",
    "build": "bun build src/index.ts --outdir ./dist --target node",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": ["discord", "bot", "typescript", "bun"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.18.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "eslint": "^9.20.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
